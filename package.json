{
  "name": "remix-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "reset-password": "node --import remix/node-tsx scripts/reset-password.ts",
    "test": "NODE_ENV=test remix test",
    "test:server": "NODE_ENV=test remix test --type server",
    "test:browser": "NODE_ENV=test remix test --type browser",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "playwright": "^1.64.0",
    "typescript": "latest"
  }
}
